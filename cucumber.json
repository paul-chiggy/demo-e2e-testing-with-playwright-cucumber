{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "publishQuiet": true,
    "dryRun": false,
    "paths": ["tests/bdd/features/"],
    "require": ["support/*.ts", "tests/bdd/steps/*.ts"],
    "requireModule": ["esbuild-register"],
    "format": [
