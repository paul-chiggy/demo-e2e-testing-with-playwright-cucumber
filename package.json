{
  "name": "demo-e2e-testing-with-playwright-cucumber",
  "version": "1.0.0",
  "description": "Demo project for end-to-end testing with Playwright and Cucumber",
  "main": "index.js",
  "scripts": {
    "test:cli": "playwright test --project chromium",
    "test:ui": "playwright test --ui --project chromium",
    "test:bdd": "cucumber-js test",
    "report:open": "playwright show-report",
    "lint": "eslint ./tests ./support",
    "lint:fix": "eslint ./tests ./support --fix",
    "update-all-packages": "npm-check-updates -u && npm install"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-chiggy/demo-e2e-testing-with-playwright-cucumber.git"
  },
  "keywords": [
    "Playwright",
    "Cucumber",
    "BDD"
  ],
  "author": "Pavlo Chigishev",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/paul-chiggy/demo-e2e-testing-with-playwright-cucumber/issues"
  },
  "homepage": "https://github.com/paul-chiggy/demo-e2e-testing-with-playwright-cucumber#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/html-formatter": "^24.1.1",
    "@cucumber/pretty-formatter": "^4.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "npm-check-updates": "^23.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
